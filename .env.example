# Copiar este archivo como .env.local para desarrollo.
# Las variables sin NEXT_PUBLIC_ son privadas: solo las lee el servidor.

# URL pública del sitio (se usa en metadata y validación de origen)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Neon (Postgres). Esquema en docs/neon-schema.sql
DATABASE_URL=

# Firma de cookies de sesión admin y hashing de rate limit. Mínimo 32 caracteres.
# Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=

# Cloudinary: subidas firmadas desde el servidor (nunca con prefijo NEXT_PUBLIC_).
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME puede reemplazar las tres.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Resend: envío por email de las consultas del formulario de contacto.
# Sin RESEND_API_KEY las consultas solo se guardan en la base (respaldo).
RESEND_API_KEY=
# A quién llegan (uno o varios separados por coma). Si falta: el email de Configuración.
CONTACT_EMAIL_TO=
# Remitente de un dominio verificado en Resend, ej: "CoFi Web <web@cofilab.com>".
# Si falta se usa onboarding@resend.dev (solo pruebas: envía únicamente al dueño de la cuenta).
CONTACT_EMAIL_FROM=
